
employees = [
    ["Rahul", 15000, 3000, 1000, 2000],
    ["Priya", 20000, 4000, 1500, 3000],
    ["Arun", 10000, 2000, 500, 1000]
]

for e in employees:
    name, basic, allowance, overtime, incentive = e

    gross = basic + allowance + overtime + incentive

    if gross <= 15000:
        deduction = gross * 0.05
    elif gross <= 25000:
        deduction = gross * 0.10
    else:
        deduction = gross * 0.15

    net = gross - deduction

    print("----------------------------")
    print("Employee:", name)
    print("Gross Salary: Rs.", gross)
    print("Deduction: Rs.", deduction)
    print("Net Salary: Rs.", net)
    print("----------------------------")
